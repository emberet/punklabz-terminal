# PunkLabz Terminal environment
PORT=4700
SESSION_SECRET=change-me-32-bytes-random
ANTHROPIC_API_KEY=
FEED_MODE=binance            # binance | coinbase | replay
PUMP_FEED_ENABLED=true
# ── operator clearance ──
# Exactly ONE wallet reaches the Control Room. Clearance is derived on every
# request from the wallet bound to your session, proved by signing a single-use
# nonce — never from a database column and never from an email address.
# Changing this address moves clearance immediately, for everyone.
ADMIN_WALLET=0xfB047FE60FFac1D1A840a6f8C518C28A5f280d23
DB_PATH=./data/punklabz.db
AUTO_APPROVE_CAP_USD=500
EPOCH_CRON=0 0 * * *

# ── model spend ──
# Hard monthly ceiling across every agent call, enforced from MEASURED token
# usage before each request. The forum, scheduled discussion and the intern all
# stop talking when it is reached.
LLM_BUDGET_USD=25

# ── forum heartbeat ──
# One agent takes a turn on this schedule, around the clock, rotating through
# every running machine and system agent. Measured cost at 5 minutes: ~$0.32
# a day, ~$9.50 a month — which together with the rest of the network's model
# usage lands near the $25 cap above. Lengthen the cron or raise the budget.
FORUM_HEARTBEAT=true
FORUM_HEARTBEAT_CRON=*/5 * * * *

# ── delegation (users letting a machine trade THEIR wallet) ──
# 'none' ships the null provider: grants can be created and revoked, nothing
# can execute. PunkLabz never holds key material — the provider does — and the
# provider-side policy must mirror the same caps.
DELEGATION_PROVIDER=none     # none | privy

# ── the intern (reads crypto social feeds, posts its own thoughts) ──
# 'none' keeps it in shadow: it drafts, is screened by the content filter, and
# is logged — and publishes nothing. Switching to live is an audited operator
# decision made after reading the block log at /intern.
X_PROVIDER=none              # none | recording | api

# ── Robinhood Chain (the home network) ──
# Mainnet is 4663, testnet is 46630. The public RPC is documented as
# rate-limited and NOT for production — supply your own, and a second provider,
# or the network runs on a single point of failure and says so in health.
PRIMARY_CHAIN_ID=4663
# RPC_ROBINHOOD_PRIMARY=https://robinhood-mainnet.g.alchemy.com/v2/<key>
# RPC_ROBINHOOD_SECONDARY=
# RPC_ROBINHOOD_TESTNET_PRIMARY=https://robinhood-testnet.g.alchemy.com/v2/<key>
# RPC_ROBINHOOD_TESTNET_SECONDARY=

# ── signer (Privy server wallet) ──
# The trading wallet key lives in Privy's enclave and never reaches this
# process. Load the separate owner authorization key from a systemd credential.
# SIGNER_PROVIDER=privy
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=              # SECRET
# PRIVY_AUTHORIZATION_KEY_FILE=/run/credentials/punklabz.service/privy_authorization_key
#                                # systemd credential containing the PKCS8 P-256 owner key.
#                                # Inline PRIVY_AUTHORIZATION_KEY is forbidden in production.
# PRIVY_WALLET_ID=
# PRIVY_POLICY_IDS=              # reviewed policy ids, comma-separated
# TRADING_WALLET_ADDRESS=        # public; verified against Privy before any signature
#
# Exact three-contract allowlist: USDG approval, WETH approval, 0x execution.
# Any missing or additional target blocks signer readiness.
# SIGNER_ALLOWED_TARGETS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168,0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73,0x0000000000001fF3684f28c67538d4D072C22734
# SIGNER_MAX_NATIVE_ETH=0        # WETH/USDG swaps must never transfer native ETH

# ── venue: 0x on Robinhood Chain ──
# ZEROX_API_KEY=
#
# The per-trade NOTIONAL cap lives in the risk core and in Privy's own policy
# engine — not here. This file cannot see the dollar value inside swap calldata.

# ── other venues (NOT wired; Robinhood Chain is the home network) ──
# Base, Solana, Polymarket and broker adapters are registered as
# NotConfiguredAdapter and refuse orders. They are kept so the instrument model
# stays honest about what exists, not because they are a step away from working.
# EXECUTION_MODE is stored in the database (live_config), not here — it is a
# preflight-gated decision, not an environment variable.
# RPC_SOLANA=
# POLYMARKET_API_KEY=
# BROKER_PROVIDER=
